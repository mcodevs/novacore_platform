# NovaCore Platform — muhit o'zgaruvchilari namunasi
# ⚠️ Haqiqiy qiymatlar `.env` faylida (repoga TUSHMAYDI) yoki `fly secrets` da.

# --- Umumiy ---
ENV=local                      # local | production
DEBUG=true
BASE_URL=https://novacore-platform.fly.dev

# --- Telegram ---
BOT_TOKEN=123456789:AA...      # BotFather'dan. Lokal va prod uchun ALOHIDA bot!
BOT_MODE=polling               # lokal: polling · prod: webhook
WEBHOOK_SECRET=random-32-bytes # webhook so'rovini tekshirish uchun
ADMIN_GROUP_ID=               # ixtiyoriy: kritik signallar uchun guruh chat_id
# TELEGRAM_PROXY=http://127.0.0.1:8080   # ixtiyoriy (aiohttp-socks kerak)

# --- Ma'lumotlar bazasi ---
# lokal (Docker'siz):  sqlite+aiosqlite:///./var/novacore.db
# lokal (compose):     postgresql+asyncpg://novacore:novacore@db:5432/novacore
# fly.io:              postgresql+asyncpg://... (fly postgres attach beradi)
DATABASE_URL=sqlite+aiosqlite:///./var/novacore.db
DB_ECHO=false

# --- Mini App / API ---
MINIAPP_URL=
CORS_ORIGINS=                  # vergul bilan: https://app.example.com
JWT_SECRET=kamida-32-baytli-tasodifiy-satr

# --- Media (Tigris / S3) ---
STORAGE_BACKEND=local          # local | s3
MEDIA_ROOT=./var/media
S3_ENDPOINT_URL=https://fly.storage.tigris.dev
S3_BUCKET=novacore-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Biznes qoidalari ---
PRICE_AUTO_ACCEPT_HOURS=48     # N4 — javob bo'lmasa avtomatik rozilik
PRICE_REMINDER_HOURS=24
DRAFT_REMINDER_HOURS=24
LONG_SERVICE_ALERT_HOURS=24
BACKGROUND_TICK_SEC=60
ANTIFRAUD_ENABLED=false        # Faza 1'da bayroqlar o'chirilgan (v1)
DEFAULT_LANG=uz

# --- Yandex Fleet (Faza 3) ---
# YANDEX_FLEET_API_KEY=
# YANDEX_FLEET_PARK_ID=
