# NovaCore Platform — muhit o'zgaruvchilari namunasi
# `make bootstrap` shu fayldan `.env` yasaydi va kalitlarni generatsiya qiladi.
# ⚠️ Haqiqiy qiymatlar `.env` da (repoga TUSHMAYDI) yoki `fly secrets` da.
#
# ❗ Izohlarni qiymat bilan bir qatorga yozmang: `KEY=  # izoh` — izoh
#    qiymatning bir qismi bo'lib qoladi.

# --- Umumiy ---
ENV=local
DEBUG=true
BASE_URL=http://localhost:8000

# --- Telegram ---
# BotFather'dan olinadi. Lokal va prod uchun ALOHIDA bot kerak:
# bitta token bitta webhook'ga bog'lanadi, polling bilan to'qnashadi.
BOT_TOKEN=
# lokal: polling · prod: webhook
BOT_MODE=polling
WEBHOOK_SECRET=change-me
# Ixtiyoriy: kritik signallar yuboriladigan guruh chat_id (masalan -1001234567890)
ADMIN_GROUP_ID=
# Ixtiyoriy: cheklangan tarmoqdan chiqish uchun (aiohttp-socks kerak)
# TELEGRAM_PROXY=http://127.0.0.1:8080

# --- Ma'lumotlar bazasi ---
# lokal (Docker'siz):  sqlite+aiosqlite:///./var/novacore.db
# lokal (compose):     postgresql+asyncpg://novacore:novacore@db:5432/novacore
# fly.io:              `fly mpg attach` DATABASE_URL sirini o'zi qo'yadi
DATABASE_URL=sqlite+aiosqlite:///./var/novacore.db
DB_ECHO=false

# --- Mini App / API ---
# Bo'sh bo'lsa: BASE_URL + /app (agar `make miniapp-build` qilingan bo'lsa)
MINIAPP_URL=
# Vergul bilan: https://app.example.com,https://other.example.com
CORS_ORIGINS=
JWT_SECRET=kamida-32-baytli-tasodifiy-satr

# --- Media (Tigris / S3) ---
# local | s3
STORAGE_BACKEND=local
MEDIA_ROOT=./var/media
S3_ENDPOINT_URL=https://fly.storage.tigris.dev
S3_BUCKET=novacore-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Biznes qoidalari ---
# N4 — javob bo'lmasa avtomatik rozilik
PRICE_AUTO_ACCEPT_HOURS=48
PRICE_REMINDER_HOURS=24
DRAFT_REMINDER_HOURS=24
LONG_SERVICE_ALERT_HOURS=24
BACKGROUND_TICK_SEC=60
# Faza 1'da bayroqlar o'chirilgan (docs/04-flows/02-antifraud.md §9 — v1)
ANTIFRAUD_ENABLED=false
DEFAULT_LANG=uz

# --- Yandex Fleet (Faza 3) ---
# YANDEX_FLEET_API_KEY=
# YANDEX_FLEET_PARK_ID=
